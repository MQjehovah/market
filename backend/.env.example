# 数据库：SQLite（默认，开箱即用）或 PostgreSQL
DATABASE_URL=sqlite+aiosqlite:///./data/marketplace.db
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/marketplace

# 能力包存储：local（默认）或 minio
ARTIFACT_STORAGE=local
ARTIFACT_DIR=./data/artifacts
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=marketplace
MINIO_SECURE=false

# 缓存：memory（默认）或 redis
CACHE_BACKEND=memory
REDIS_URL=redis://localhost:6379/0

# 安全
JWT_SECRET=change-me-in-production-with-at-least-32-bytes
JWT_EXPIRE_MINUTES=1440

# 初始管理员
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin123
SEED_ADMIN_EMAIL=admin@example.com
