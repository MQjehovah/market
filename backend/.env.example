# 数据库：SQLite（默认，开箱即用）或 PostgreSQL
DATABASE_URL=sqlite+aiosqlite:///./data/marketplace.db
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/marketplace

# 运行环境:production/prod(大小写不敏感)下缺失或弱 secret 会拒绝启动;默认 development
APP_ENV=development

# 能力包存储：local（默认）或 minio
ARTIFACT_STORAGE=local
ARTIFACT_DIR=./data/artifacts
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=marketplace
MINIO_SECURE=false

# 安全
JWT_SECRET=change-me
JWT_EXPIRE_MINUTES=720
# 前端源，逗号分隔。
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# 暴露 MCP 网关时须置 true，否则 api_token 拒绝访问。
MCP_GATEWAY_REQUIRE_TOKEN=false

# 初始管理员（生产必须替换为强口令;change-me 属于弱值,模板不可直接上线）
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=change-me
SEED_ADMIN_EMAIL=admin@example.com

# Agent 真实执行（OpenAI 兼容网关，如 ai.rosiwit.com/v1）
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
AGENT_MAX_ITERATIONS=10

# 开发端口（对接生产 SSO 时用 8093，与已注册回调一致）
# PORT=8093

# SSO/OIDC（配置 SSO_ISSUER 后启用双轨鉴权与企业登录跳转）
# 本地 SSO:
# SSO_ISSUER=http://127.0.0.1:8091
# SSO_JWKS_URI=http://127.0.0.1:8091/.well-known/jwks.json
# SSO_REDIRECT_URI=http://127.0.0.1:8000/api/auth/oidc/callback
# SSO_REDIRECT_TARGET=http://127.0.0.1:5173/login
# 生产 SSO（线上 market 回调，需在 SSO clients.json 注册）:
# SSO_ISSUER=http://192.168.31.45:8091
# SSO_JWKS_URI=http://192.168.31.45:8091/.well-known/jwks.json
# SSO_REDIRECT_URI=http://192.168.31.34:8093/api/auth/oidc/callback
# SSO_REDIRECT_TARGET=/login
# SSO_AUDIENCE=market
# SSO_CLIENT_ID=market
# SSO_CLIENT_SECRET=xzrobot-market-2026
