# 数据库：SQLite（默认，开箱即用）或 PostgreSQL
DATABASE_URL=sqlite+aiosqlite:///./data/marketplace.db
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/marketplace

# 能力包存储：local（默认）或 minio
ARTIFACT_STORAGE=local
ARTIFACT_DIR=./data/artifacts
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=marketplace
MINIO_SECURE=false

# 安全
JWT_SECRET=change-me-in-production-with-at-least-32-bytes
JWT_EXPIRE_MINUTES=1440
# 前端源（逗号分隔）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# 生产对外暴露 MCP 网关时建议 true（空 api_token 拒绝访问）
MCP_GATEWAY_REQUIRE_TOKEN=false

# 初始管理员
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin123
SEED_ADMIN_EMAIL=admin@example.com

# Agent 真实执行（OpenAI 兼容网关，如 ai.rosiwit.com/v1）
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
AGENT_MAX_ITERATIONS=10
